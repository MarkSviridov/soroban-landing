---
import Container from '@/components/ui/Container.astro';
import { site, getLocale } from '@/content/site';
import { SITE, PHONE, SOCIALS, OFFICES } from '@/consts';

const t = site[getLocale(Astro.url)];
const year = new Date().getFullYear();
const foundedText = t.footer.foundedText.replace('{year}', String(SITE.foundedInMoldova));
---

<footer class="border-ink-900/10 bg-surface-muted border-t">
  <Container class="grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-ink-900 flex items-center gap-2.5 text-lg font-black">
        <img
          src="/images/logo/logo%20soroban.jpg"
          alt={t.logoAlt}
          width="960"
          height="958"
          decoding="async"
          loading="lazy"
          class="ring-ink-900/10 h-8 w-8 rounded-md bg-white p-0.5 ring-1"
        />
        <span>SOROBAN <span class="text-brand-600">{t.brandCity}</span></span>
      </p>
      <p class="text-ink-500 mt-2 text-sm">{t.footer.tagline}</p>
      <p class="text-ink-500 mt-2 text-sm">{foundedText}</p>
    </div>

    <nav aria-label={t.a11y.footerNav}>
      <p class="text-ink-900 text-sm font-bold">{t.footer.sectionsTitle}</p>
      <ul class="text-ink-700 mt-3 space-y-2 text-sm">
        {
          t.footerNav.map((i) => (
            <li>
              <a href={i.href} class="hover:text-brand-600">
                {i.label}
              </a>
            </li>
          ))
        }
        <li><a href="#lead-form" class="hover:text-brand-600">{t.cta.primary}</a></li>
      </ul>
    </nav>

    <div>
      <p class="text-ink-900 text-sm font-bold">{t.footer.contactsTitle}</p>
      <ul class="text-ink-700 mt-3 space-y-2 text-sm">
        <li>
          <a href={PHONE.href} class="hover:text-brand-600 font-semibold">{PHONE.display}</a>
        </li>
        {
          OFFICES.map((o) => (
            <li>
              {t.contacts.officeDistricts[o.id]}: {o.address}
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-ink-900 text-sm font-bold">{t.footer.linksTitle}</p>
      <ul class="text-ink-700 mt-3 space-y-2 text-sm">
        <li>
          <a href={SITE.mainSite} target="_blank" rel="noopener" class="hover:text-brand-600">
            {t.footer.siteLink}
          </a>
        </li>
        {
          SOCIALS.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener" class="hover:text-brand-600">
                {s.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={getLocale(Astro.url) === 'ro' ? '/ro/privacy' : '/privacy'}
            class="hover:text-brand-600">{t.footer.privacy}</a
          >
        </li>
      </ul>
    </div>
  </Container>

  <div class="border-ink-900/10 border-t">
    <Container class="py-6">
      <p class="text-ink-500 text-xs">© {year} SOROBAN. {t.footer.tagline}.</p>
    </Container>
  </div>
</footer>
