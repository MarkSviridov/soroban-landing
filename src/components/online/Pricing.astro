---
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { online, getOnlineLocale } from '@/content/online';

const t = online[getOnlineLocale(Astro.url)];
---

<Section id="pricing">
  <SectionHeading
    eyebrow={t.pricing.eyebrow}
    title={t.pricing.title}
    intro={t.pricing.intro}
    align="center"
  />

  <div class="mt-10 grid gap-5 lg:grid-cols-3">
    {
      t.pricing.tiers.map((tier) => (
        <div
          class:list={[
            'relative flex flex-col rounded-2xl border p-6',
            tier.highlighted
              ? 'border-brand-400 bg-surface ring-brand-400/30 shadow-lg ring-2'
              : 'border-ink-900/10 bg-surface',
          ]}
        >
          <h3 class="font-display text-ink-900 text-lg font-extrabold">{tier.name}</h3>
          <p class="mt-3 flex items-baseline gap-1.5">
            <span class="font-display text-ink-900 text-4xl font-black">{tier.price}</span>
            <span class="text-ink-500 text-sm">{tier.period}</span>
          </p>
          <p class="text-ink-500 mt-2 text-sm">{tier.note}</p>
          <ul class="mt-5 flex-1 space-y-2.5">
            {tier.features.map((f) => (
              <li class="text-ink-700 flex items-start gap-2 text-sm">
                <Icon name="lucide:check" class="text-brand-500 mt-0.5 h-4 w-4 shrink-0" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
          <Button
            href="#lead"
            variant={tier.highlighted ? 'primary' : 'ghost'}
            size="md"
            class="mt-6 w-full"
            data-analytics={`online_pricing_${tier.id}`}
          >
            {t.pricing.cta}
          </Button>
        </div>
      ))
    }
  </div>

  <div class="border-ink-900/10 bg-surface-muted mx-auto mt-8 max-w-3xl rounded-2xl border p-6">
    <h3 class="font-display text-ink-900 text-sm font-bold tracking-wide uppercase">
      {t.pricing.includedTitle}
    </h3>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      {
        t.pricing.included.map((i) => (
          <li class="text-ink-700 flex items-start gap-2 text-sm">
            <Icon name="lucide:check" class="text-brand-500 mt-0.5 h-4 w-4 shrink-0" />
            <span>{i}</span>
          </li>
        ))
      }
    </ul>
    <p class="text-ink-500 mt-4 text-sm">{t.pricing.footnote}</p>
  </div>
</Section>
