---
import '@/styles/global.css';
import { SITE } from '@/consts';
import { site, getLocale, localeUrls } from '@/content/site';

interface Props {
  title: string;
  description: string;
  /** Путь к OG-картинке относительно корня сайта. */
  image?: string;
  noindex?: boolean;
}

const { title, description, image = '/images/og/og-default.png', noindex = false } = Astro.props;

const t = site[getLocale(Astro.url)];

const fallbackOrigin = 'https://soroban.digital';
const base = Astro.site ?? fallbackOrigin;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;

const alt = localeUrls(Astro.url.pathname);
const hrefRu = new URL(alt.ru, base).href;
const hrefRo = new URL(alt.ro, base).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={hrefRu} />
    <link rel="alternate" hreflang="ro" href={hrefRo} />
    <link rel="alternate" hreflang="x-default" href={hrefRu} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&family=Nunito:wght@700;800;900&display=swap"
    />

    <slot name="head" />

    {/* Meta Pixel Code */}
    <script
      is:inline
      set:html={`!function(f,b,e,v,n,t,s)
{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
n.callMethod.apply(n,arguments):n.queue.push(arguments)};
if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
n.queue=[];t=b.createElement(e);t.async=!0;
t.src=v;s=b.getElementsByTagName(e)[0];
s.parentNode.insertBefore(t,s)}(window, document,'script',
'https://connect.facebook.net/en_US/fbevents.js');
fbq('init', '1129340699585489');
fbq('track', 'PageView');`}
    />
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src="https://www.facebook.com/tr?id=1129340699585489&ev=PageView&noscript=1"
        alt=""
      />
    </noscript>
    {/* End Meta Pixel Code */}

    {/* Yandex.Metrika counter */}
    <script
      is:inline
      set:html={`(function(m,e,t,r,i,k,a){
    m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
    m[i].l=1*new Date();
    for (var j = 0; j < document.scripts.length; j++) {
        if (document.scripts[j].src === r) { return; }
    }
    k=e.createElement(t),
    a=e.getElementsByTagName(t)[0],
    k.async=1,
    k.src=r,
    a.parentNode.insertBefore(k,a)
})(window, document, 'script',
   'https://mc.yandex.ru/metrika/tag.js?id=112327725', 'ym');

ym(112327725, 'init', {
    ssr:true,
    webvisor:true,
    clickmap:true,
    ecommerce:"dataLayer",
    referrer: document.referrer,
    url: location.href,
    accurateTrackBounce:true,
    trackLinks:true
});`}
    />
    <noscript>
      <div>
        <img
          src="https://mc.yandex.ru/watch/112327725"
          style="position:absolute; left:-9999px;"
          alt=""
        />
      </div>
    </noscript>
    {/* End Yandex.Metrika counter */}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#top"
      class="focus:bg-brand-500 sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
    >
      {t.skipLink}
    </a>
    <slot />
  </body>
</html>
