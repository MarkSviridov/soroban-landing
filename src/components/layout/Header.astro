---
import { Icon } from 'astro-icon/components';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import LangSwitch from '@/components/layout/LangSwitch.astro';
import { site, getLocale } from '@/content/site';

const t = site[getLocale(Astro.url)];
const nav = t.nav;
---

<header id="top" class="border-ink-900/10 bg-surface/90 sticky top-0 z-50 border-b backdrop-blur">
  <Container class="flex h-16 items-center justify-between gap-4">
    <a href="#top" class="font-display text-ink-900 flex items-center gap-2.5 text-xl font-black">
      <img
        src="/images/logo/logo%20soroban.jpg"
        alt={t.logoAlt}
        width="960"
        height="958"
        decoding="async"
        loading="eager"
        class="ring-ink-900/10 h-9 w-9 rounded-md bg-white p-0.5 ring-1"
      />
      <span>SOROBAN <span class="text-brand-600 text-sm font-bold">{t.brandCity}</span></span>
    </a>

    <nav aria-label={t.a11y.mainNav} class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {
          nav.map((i) => (
            <li>
              <a href={i.href} class="text-ink-700 hover:text-brand-600 text-sm font-semibold">
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <LangSwitch />
      <Button href="#lead-form" size="md">{t.cta.primary}</Button>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="text-ink-900 focus-visible:outline-brand-600 inline-flex h-10 w-10 items-center justify-center rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.a11y.openMenu}
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
    >
      <span id="menu-icon-open"><Icon name="lucide:menu" class="h-6 w-6" /></span>
      <span id="menu-icon-close" class="hidden"><Icon name="lucide:x" class="h-6 w-6" /></span>
    </button>
  </Container>

  <div id="mobile-menu" class="border-ink-900/10 bg-surface hidden border-t lg:hidden">
    <Container class="py-4">
      <ul class="flex flex-col gap-1">
        {
          nav.map((i) => (
            <li>
              <a
                href={i.href}
                data-menu-link
                class="text-ink-700 hover:bg-surface-muted block rounded-lg px-2 py-3 text-base font-semibold"
              >
                {i.label}
              </a>
            </li>
          ))
        }
        <li class="mt-2 px-2">
          <LangSwitch />
        </li>
        <li class="mt-2">
          <Button href="#lead-form" class="w-full">{t.cta.primary}</Button>
        </li>
      </ul>
    </Container>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggle && menu) {
    const labelOpen = toggle.dataset.labelOpen ?? 'Menu';
    const labelClose = toggle.dataset.labelClose ?? 'Close';

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? labelClose : labelOpen);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu
      .querySelectorAll('[data-menu-link]')
      .forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
