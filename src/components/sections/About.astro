---
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Photo from '@/components/ui/Photo.astro';
import { site, getLocale } from '@/content/site';

const t = site[getLocale(Astro.url)];
---

<Section id="about">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <SectionHeading eyebrow={t.about.eyebrow} title={t.about.title} />
      <div class="text-ink-700 mt-6 grid gap-4 text-lg">
        {t.about.text.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <Photo
      src="/images/optimized/photos/about-soroban-classroom.webp"
      alt={t.about.imageAlt}
      width={1170}
      height={878}
      class="border-ink-900/10 h-auto w-full rounded-3xl border shadow-sm"
    />
  </div>
</Section>
