---
/**
 * Приветственное видео преподавателя. Выводится только там, где для локали
 * есть своя запись (сейчас — румынский). Тёмный фон намеренно: секция стоит
 * между светлыми блоками и должна читаться как «посмотрите».
 */
import { Icon } from 'astro-icon/components';
import Container from '@/components/ui/Container.astro';
import { online, getOnlineLocale, WELCOME_VIDEO } from '@/content/online';

const locale = getOnlineLocale(Astro.url);
const t = online[locale];
const video = WELCOME_VIDEO[locale];
---

{
  video && (
    <section id="welcome" class="bg-ink-900 scroll-mt-24 py-16 sm:py-20 lg:py-24">
      <Container>
        <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
          <div>
            <p class="font-display text-brand-300 text-sm font-bold tracking-wide uppercase">
              {t.welcome.eyebrow}
            </p>
            <h2 class="font-display mt-2 text-3xl font-black text-white sm:text-4xl">
              {t.welcome.title}
            </h2>
            <p class="mt-4 max-w-xl text-lg text-white/80">{t.welcome.intro}</p>
            <ul class="mt-6 space-y-3">
              {t.welcome.points.map((p) => (
                <li class="flex items-start gap-3 text-white/90">
                  <Icon name="lucide:check" class="text-accent-300 mt-1 h-4 w-4 shrink-0" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>

          <figure class="mx-auto w-full max-w-[320px] sm:max-w-[360px]">
            <div class="overflow-hidden rounded-3xl bg-black shadow-2xl ring-1 ring-white/10">
              <video
                class="aspect-[9/16] h-auto w-full"
                controls
                playsinline
                preload="none"
                poster={video.poster}
                width={video.width}
                height={video.height}
                aria-label={t.welcome.videoLabel}
                data-analytics="online_welcome_video"
              >
                <source src={video.src} type="video/mp4" />
                {t.hero.videoFallback}
              </video>
            </div>
            <figcaption class="sr-only">{t.welcome.videoLabel}</figcaption>
          </figure>
        </div>
      </Container>
    </section>
  )
}
