---
import { Icon } from 'astro-icon/components';
import Section from '@/components/ui/Section.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site, getLocale } from '@/content/site';

const t = site[getLocale(Astro.url)];

const icons = ['lucide:calculator', 'lucide:eye', 'lucide:repeat', 'lucide:users'];
---

<Section id="benefits" muted>
  <SectionHeading eyebrow={t.learn.eyebrow} title={t.learn.title} />

  <ul class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      t.learn.items.map((item, index) => (
        <li class="border-ink-900/5 bg-surface flex items-start gap-4 rounded-2xl border p-6 shadow-sm">
          <Icon name={icons[index % icons.length]} class="text-brand-500 h-6 w-6 shrink-0" />
          <span class="text-ink-700">{item}</span>
        </li>
      ))
    }
  </ul>

  <p class="text-ink-500 mt-6 max-w-2xl text-sm">{t.learn.note}</p>
</Section>
