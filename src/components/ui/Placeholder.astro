---
import { Icon } from 'astro-icon/components';

/**
 * Универсальная заглушка под будущий реальный ассет (фото / скриншот / видео).
 * Меняется на <Image> или <video> без изменения соседней вёрстки —
 * достаточно сохранить соотношение сторон (ratio).
 */
interface Props {
  label: string;
  /** Соотношение сторон в формате CSS aspect-ratio, напр. '4/3', '16/9', '9/19'. */
  ratio?: string;
  icon?: string;
  class?: string;
}

const { label, ratio = '4/3', icon = 'lucide:image', class: className = '' }: Props = Astro.props;
---

<div
  class:list={[
    'border-ink-300/60 bg-surface-muted flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed p-6 text-center',
    className,
  ]}
  style={`aspect-ratio:${ratio}`}
  role="img"
  aria-label={`Заглушка: ${label}`}
>
  <Icon name={icon} class="text-ink-300 h-8 w-8" />
  <span class="text-ink-500 text-sm font-semibold">{label}</span>
</div>
