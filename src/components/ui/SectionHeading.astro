---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  as?: 'h2' | 'h3';
}

const { eyebrow, title, intro, align = 'left', as: Tag = 'h2' }: Props = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {
    eyebrow && (
      <p class="font-display text-brand-600 text-sm font-bold tracking-wide uppercase">{eyebrow}</p>
    )
  }
  <Tag class="font-display text-ink-900 mt-2 text-3xl font-black sm:text-4xl">{title}</Tag>
  {intro && <p class="text-ink-700 mt-4 text-lg">{intro}</p>}
</div>
